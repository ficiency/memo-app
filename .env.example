# Copy this file to .env and fill the two blanks. .env is not committed.

# Postgres connection. Supabase gives this under Project Settings → Database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Key from platform.openai.com. Onboarding, binding and the agent call the model with it.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.5.
# OPENAI_MODEL=gpt-5.5

# Optional. Origins allowed to call the API. Default is the local frontend.
# CORS_ORIGINS=http://localhost:5173

# Optional. pdf uses PowerPoint on Windows when this is empty. Set libreoffice on a machine that has it.
# PDF_ENGINE=

# Optional. Folder of the firm's font files. Default searches the system fonts.
# FONTS_DIR=
